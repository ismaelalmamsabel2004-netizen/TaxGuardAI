generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Transaccion {
  id               Int      @id @default(autoincrement())
  userId           String
  empresaId        String?  
  fecha            DateTime
  tipo             String
  baseImponible    Float
  iva              Float?
  categoria        String?
  isRecurrent      Boolean? @default(false)
  frecuencia       String?

  // Campos extra para Facturación PDF (INTACTOS)
  numero_factura   String?
  cliente_nombre   String?
  cliente_nif      String?
  concepto_detalle String?

  createdAt        DateTime @default(now())

  // 🚀=============================================================🚀
  // 🌟 NUEVOS CAMPOS AÑADIDOS: EXPANSIÓN PRO (Sin romper nada) 🌟
  // Todos son opcionales (?) para que el código viejo siga funcionando
  // 🚀=============================================================🚀

  // 📁 1. GESTOR DOCUMENTAL AVANZADO
  // Para que el cliente tenga su propio "Google Drive" de facturas
  url_archivo      String?  // El enlace de la foto del ticket o el PDF en la nube
  nombre_archivo   String?  // Nombre editable (ej: "Factura Amazon Servidores")
  tipo_archivo     String?  // Para diferenciar si es un ticket (JPG) o factura (PDF)

  // 🚨 2. RADAR DE MOROSIDAD Y TESORERÍA
  estado_pago      String?  @default("COBRADO") // Puede ser: "PENDIENTE", "COBRADO", "PAGADO"
  fecha_vencimiento DateTime? // Día límite de pago para lanzar alertas automáticas
  metodo_pago      String?  // "Transferencia", "Tarjeta", "Efectivo", "Stripe"

  // 🧠 3. ORGANIZACIÓN Y BÚSQUEDA
  notas_internas   String?  // Cuadro de texto para notas privadas del usuario
  etiqueta_color   String?  // Para organizar gastos por colores en la tabla
  
  // Saber cuándo fue la última vez que el usuario modificó esta factura
  updatedAt        DateTime @default(now()) @updatedAt 

  // 🛡️ ÍNDICES DE RENDIMIENTO: absolutamente TODAS las pantallas de la app filtran las
  // transacciones por usuario y/o empresa. Sin estos índices, cada consulta obligaba a la
  // base de datos a recorrer la tabla entera fila a fila (escaneo secuencial), algo que
  // funciona bien con pocos datos pero se vuelve cada vez más lento a medida que un cliente
  // acumula meses o años de movimientos. Con miles de filas, esto es la diferencia entre una
  // consulta instantánea y una que tarda varios segundos.
  @@index([userId, empresaId])
  // 🛡️ BLINDAJE LEGAL ANTI-DUPLICADOS: la comprobación de número de factura libre se hacía en
  // dos pasos separados (leer y luego escribir), así que dos guardados casi simultáneos (doble
  // clic, dos pestañas) podían colar el mismo número en dos facturas distintas, algo ilegal ante
  // Hacienda. Esta restricción única hace que la propia base de datos rechace cualquier duplicado,
  // pase lo que pase en la capa de aplicación. Los NULL no cuentan como duplicados entre sí, así
  // que los movimientos sin número de factura no se ven afectados.
  @@unique([userId, empresaId, numero_factura])
}

// 🏢===============================================================🏢
// 🌟 NUEVO MODELO DE VALOR: MINI-CRM PARA TUS CLIENTES 🌟
// Esto permite que guarden su agenda de contactos y no tengan que
// teclear el NIF y el nombre cada vez que hacen una factura.
// 🏢===============================================================🏢

model ContactoEmpresa {
  id               Int      @id @default(autoincrement())
  userId           String
  empresaId        String
  tipo             String   // Para diferenciar "CLIENTE" o "PROVEEDOR"
  nombre           String
  nif              String?
  email            String?
  telefono         String?
  direccion        String?
  iban_bancario    String?  // Para saber a qué cuenta hacer transferencias
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  // Mismo motivo que en Transaccion: el CRM siempre se consulta filtrado por empresa.
  @@index([userId, empresaId])
}

// 🤝===============================================================🤝
// 🌟 NUEVO MODELO B2B: MODO ASESOR (MULTICUENTA Y PERMISOS) 🌟
// El puente de seguridad que permite a Marc entrar a tus datos en "Solo Lectura"
// 🤝===============================================================🤝

model PermisoEmpresa {
  id            Int      @id @default(autoincrement())
  empresaId     String   // El nombre del espacio de trabajo (ej: "Mi Empresa")
  propietarioId String   // El ID del usuario creador (CEO original)
  asesorEmail   String   // El email del gestor invitado (ej: mmontolio7@hotmail.com)
  rol           String   @default("LECTURA") // "LECTURA" para gestores, "ADMIN" para socios
  
  createdAt     DateTime @default(now())

  // Regla de seguridad pura: Evita que invites a la misma persona dos veces al mismo espacio
  @@unique([empresaId, propietarioId, asesorEmail])
}